{
  "name": "decadra",
  "version": "0.4.0",
  "description": "Does the AI coding plan you pay for fit the usage you put through it. Per provider, never across providers.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": { "type": "git", "url": "git+https://github.com/decadra/cli.git" },
  "homepage": "https://decadra.dev",
  "bugs": { "url": "https://github.com/decadra/cli/issues" },
  "keywords": ["claude-code", "codex", "cursor", "devin", "usage", "subscription", "cli"],
  "bin": { "decadra": "./dist/cli.js" },
  "files": ["dist", "schema", "assets", "README.md", "LICENSE"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "gen:logomark": "tsx scripts/gen-logomark.ts",
    "gen:public-tree": "tsx scripts/build-public-tree.ts",
    "check": "npm run lint && npm test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "ccusage": "20.0.20",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "picocolors": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
